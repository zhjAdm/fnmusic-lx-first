# Copy to .env; keep .env private. Values are data, shell substitution is not performed.
LX_PASSWORD='replace-with-at-least-16-random-characters'
LX_URL=http://127.0.0.1:8005
LX_PLATFORMS=kg,tx,kw,wy,mg
DATA_DIR=/opt/fnmusic-lx/data
# Must be a directory scanned by official Music and readable by its service account.
DOWNLOAD_DIR=/vol1/1000/music/聆澜收藏
UPSTREAM_SOCKET=/var/run/trim_music.original.socket
LISTEN_SOCKET=/var/run/fnmusic-lx.socket
PLAY_MODE=direct
PLAY_QUALITY=320k
# Set a GUID to select an existing accessible playlist, otherwise find/create 默认歌单.
DEFAULT_PLAYLIST_GUID=''
# Optional: use the actual scan request path/body captured from your installed version.
# Empty: wait for official automatic/manual scanning; never guess a scan endpoint.
# Legacy compatibility only; local indexing never calls the official scan API.
SCAN_PATH=''
SCAN_BODY='{}'
PUBLIC_PLAYLISTS='[]'
# Example: PUBLIC_PLAYLISTS='[{"source":"kw","id":"123456","name":"我的在线歌单"}]'
HOT_SOURCE=kg
HOT_BOARD=''
